<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rajok.dubstudio"
    android:versionCode="4"
    android:versionName="1.3">

    <!-- One permission, and nothing else. The app never touches storage,
         contacts, location, phone state or the camera: videos are opened
         through the system document picker, which needs no permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="36" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".FileProviderLite"
            android:authorities="com.rajok.dubstudio.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
